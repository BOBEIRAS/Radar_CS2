<Window x:Class="launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Web Radar — Command Center" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#080A0F" Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#1E2538" BorderThickness="1">

    <Window.Resources>
        <!-- Modern ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#2A354D" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button (Glow Emerald) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#022114"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="1"
                                BorderBrush="#34D399"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#34D399" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Surface Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#121724"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#222B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2234"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F1420"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Panel Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1420" Offset="0"/>
                        <GradientStop Color="#0B0F19" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#1E2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="36"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#0C101A" BorderBrush="#1B2232" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="20,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22" Margin="0,0,12,0">
                        <Ellipse Fill="#10B981" Opacity="0.2"/>
                        <Ellipse Width="8" Height="8" Fill="#10B981">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    
                    <TextBlock Text="CS2 WEB RADAR" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <TextBlock Text="PRO COMMAND CENTER" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    
                    <Border Background="#121B2D" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WEB RADAR" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="•" FontSize="10" Foreground="#475569" Margin="6,0"/>
                            <TextBlock Text="v2.0" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" ToolTip="Minimizar">
                        <Path Data="M0,7 L12,7" Stroke="#94A3B8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Click="Close_Click" Width="36" Height="30" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" ToolTip="Fechar">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#EF4444" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <!-- Control Panel -->
                <ColumnDefinition Width="*"/>
                <!-- Telemetry & Live Logs -->
            </Grid.ColumnDefinitions>

            <!-- Left Column: Controls & System Indicators -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                
                <!-- Master Action Card -->
                <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="CORE SYSTEM CONTROLS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#131B2A" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="HOTKEY READY" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>

                        <Button x:Name="btnMaster" Style="{StaticResource ActionButton}" Height="46" Click="BtnMaster_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="txtMasterBtnIcon" Text="▶" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtMasterBtn" Text="START RADAR SUITE" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Standalone Overlay HUD Button -->
                        <Button x:Name="btnOpenOverlay" Style="{StaticResource ActionButton}" Height="36" Margin="0,8,0,0" Click="BtnOpenOverlay_Click" ToolTip="Open borderless in-game overlay HUD">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0369A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,3 L15,3 L15,11 L3,11 Z M7,7 L19,7 L19,15 L7,15 Z" Stroke="#E0F2FE" StrokeThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LAUNCH OVERLAY MODE (HUD)" FontSize="11" FontWeight="Bold" Foreground="#F0F9FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnOpenBrowser" Grid.Column="0" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,4,0" Click="BtnOpenBrowser_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,3 L9,3 M9,3 L9,9 M9,3 L3,9" Stroke="#38BDF8" StrokeThickness="1.2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open Web Radar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCopyLink" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Margin="4,0,0,0" Click="BtnCopyLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,4 L7,4 L7,9 L2,9 Z M5,2 L10,2 L10,7" Stroke="#A78BFA" StrokeThickness="1.2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy Cloudflare" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Subsystem Diagnostics Card -->
                <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="REALTIME SUBSYSTEM TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14"/>

                        <!-- CS2 Game State -->
                        <Border Background="#090D15" BorderBrush="#181F2F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotCs2" Width="8" Height="8" Fill="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Counter-Strike 2 Engine" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblCs2Status" Text="NOT RUNNING" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Kernel Driver State -->
                        <Border Background="#090D15" BorderBrush="#181F2F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotKernel" Width="8" Height="8" Fill="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kernel Driver (Ring 0)" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblKernelStatus" Text="OFFLINE" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Web Backend State -->
                        <Border Background="#090D15" BorderBrush="#181F2F" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotServer" Width="8" Height="8" Fill="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="WebSocket Relay Server" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblServerStatus" Text="STOPPED" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Cloudflare Tunnel -->
                        <Border Background="#090D15" BorderBrush="#181F2F" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotTunnel" Width="8" Height="8" Fill="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cloudflare Live Tunnel" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblTunnelStatus" Text="INACTIVE" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Right Column: Live Console Logs & Network Links -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- URL Bar Card -->
                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0"/>
                            <TextBlock Text="RADAR URL:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBox x:Name="txtPublicUrl" Grid.Column="1" Text="Waiting for radar suite to start..." IsReadOnly="True" Background="#060910" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#1B2436" Padding="10,6" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        
                        <Button Grid.Column="2" Content="Copy URL" Style="{StaticResource SecondaryButton}" Height="32" Width="80" Margin="10,0,0,0" Click="BtnCopyLink_Click"/>
                    </Grid>
                </Border>

                <!-- Console Output Card -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE TELEMETRY &amp; CONSOLE STREAM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Border Background="#131C2D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="STREAMING" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                            <Button Content="Clear Console" HorizontalAlignment="Right" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="10" Cursor="Hand" Click="BtnClearLogs_Click"/>
                        </Grid>
                        
                        <Border Grid.Row="1" Background="#05070B" BorderBrush="#151D2C" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtLogs" IsReadOnly="True" Background="Transparent" Foreground="#6EE7B7" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#070A10" BorderBrush="#161E2E" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENGINE:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblEngineState" Text="IDLE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,16,0"/>
                    
                    <TextBlock Text="WS PORT:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblEnginePort" Text="22006" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,16,0"/>

                    <TextBlock Text="MODE:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock Text="USERMODE STANDALONE" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
                
                <TextBlock HorizontalAlignment="Right" Text="CS2 WEB RADAR • NEXT-GEN TACTICAL COMMAND" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
